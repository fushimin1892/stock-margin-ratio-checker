# このファイルを .env にコピーして値を入れると、ローカルでも本番と同じ設定で動きます。
# .env は git に入りません (.gitignore 済み)。
# Vercel では「Settings → Environment Variables」に同じ名前で登録します。

# ---- アカウント情報の保存先 (本番では必須) ----------------------------------
# Vercel の Storage で KV (Upstash Redis) を接続すると自動で入ります。
# ローカルで未設定のときは .data/auth.json に保存されるので、そのままでも動きます。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- パスワード再設定メールの送信 ------------------------------------------
# 未設定のときはメールを送らず、再設定リンクを画面とサーバーのログに出します(開発用)。
# 例) Gmail: SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_PASS はアプリパスワード
#     (2段階認証を有効にしたうえで https://myaccount.google.com/apppasswords で発行)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=信用残ウォッチ

# ---- 公開サイトの URL ------------------------------------------------------
# 再設定メールに載せるリンクの宛先。末尾はスラッシュ付きで。
SITE_URL=

# ---- 追加で API を呼んでよいオリジン (カンマ区切り) --------------------------
# 既定で GitHub Pages・Vercel の本番URL・localhost は許可済みです。
ALLOWED_ORIGINS=
